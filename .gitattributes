# Normalize text line endings to LF across Windows and Linux CI
* text=auto eol=lf

# Force LF for shell, Python, YAML, Markdown, and web assets
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Keep Windows batch/PowerShell scripts CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Treat binary assets explicitly
*.png binary
*.jpg binary
*.gif binary
*.ico binary
